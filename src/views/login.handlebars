<section class="auth-page">
  <div class="auth-card">
    <span class="eyebrow">STATELESS SESSION</span>
    <h1>Đăng nhập</h1>
    <p>Đăng nhập để sử dụng chức năng thêm sách.</p>

    {{#if error}}
      <div class="alert error">{{error}}</div>
    {{/if}}

    <form action="/auth/login" method="POST" class="book-form">
      <label>
        Tên người dùng
        <input name="username" placeholder="student" required>
      </label>

      <button class="btn btn-primary full" type="submit">
        Đăng nhập
      </button>
    </form>

    <a class="back-link" href="/">← Quay lại danh sách sách</a>
  </div>
</section>
