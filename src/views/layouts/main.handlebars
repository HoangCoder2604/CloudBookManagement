<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}}</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="topbar">
    <div class="container nav">
      <a href="/" class="brand">Cloud Book Manager</a>

      <div class="nav-actions">
        {{#if isLoggedIn}}
          <span class="user-badge">👤 {{user.username}}</span>
          <form action="/auth/logout" method="POST">
            <button class="btn btn-outline" type="submit">Đăng xuất</button>
          </form>
        {{else}}
          <a class="btn btn-primary" href="/auth/login">Đăng nhập</a>
        {{/if}}
      </div>
    </div>
  </header>

  <main class="container">
    {{{body}}}
  </main>

  <footer class="footer">
    <div class="container footer-content">
      <div>
        <strong>{{studentName}}</strong>
        <span>MSSV: {{mssv}}</span>
      </div>
      <div>
        VAT áp dụng:
        <strong>{{#if student}}{{student.vat}}%{{else}}theo MSSV{{/if}}</strong>
      </div>
    </div>
  </footer>
</body>
</html>
